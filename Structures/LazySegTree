#include<bits/stdc++.h>
using namespace std;
#define int long long

const int MAXN = 1e5 + 5;
int n,q;
vector<int> v(MAXN);

struct SegTree 
{
    int tree[4 * MAXN];
    int lazy[4 * MAXN];

    void push(int node, int tl, int tr){
        if(lazy[node] == 0) return;
        tree[node] += (tr - tl + 1) * lazy[node];

        if(tr != tl){
            lazy[2 * node] += lazy[node];
            lazy[2 * node + 1] += lazy[node];
        }
        lazy[node] = 0;
    }

    void build(int node, int tl, int tr){
        lazy[node] = 0;
        if(tl == tr) {
            tree[node] = v[tl];
            return;
        }
        int mid = (tl + tr) / 2;
        build(2 * node, tl, mid);
        build(2 * node + 1, mid + 1, tr);
        tree[node] = tree[2 * node] + tree[2 * node + 1];
    }

    void update(int node, int value, int tl, int tr, int start, int end){
        push(node, tl, tr);
        if(tl > end || tr < start) return;
        if(tl >= start && tr <= end){
            lazy[node] += value;
            push(node, tl, tr);
            return;
        }
        int mid = (tl + tr) / 2;

        update(2 * node, value, tl, mid, start, end);
        update(2 * node + 1, value, mid + 1, tr, start, end);
        tree[node] = tree[2 * node] + tree[2 * node + 1];
    }
    int query(int node, int tl, int tr, int start, int end){
        push(node, tl, tr);
        int mid = (tl + tr) / 2;
        if(tl > end || tr < start) return 0;
        if(tl >= start && tr <= end) return tree[node];
        return query(2 * node, tl, mid, start, end) + query(2 * node + 1, mid + 1, tr, start, end);
    }
} seq;

int32_t main(){
    cin >> n >> q;
    vector<int> res;
    for(int i = 1; i <= n; i++) cin >> v[i];
    seq.build(1,1,n);
    for(int i = 0; i < q; i++){
        int a; cin >> a;
        if(a == 1){
            int tl, tr, value; cin >> tl >> tr >> value;
            seq.update(1, value, 1, n, tl, tr);
        }
        if(a == 2){
            int tl, tr; cin >> tl >> tr;
            res.push_back(seq.query(1, 1, n, tl, tr));
        }
    }
    for(int item : res) cout << item << endl;
}
